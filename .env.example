# ─── App ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Database (Supabase or any PostgreSQL) ────────────────────────────────────
DATABASE_URL="postgresql://user:password@host:5432/foine_hair?schema=public"

# ─── Cloudinary ───────────────────────────────────────────────────────────────
# Sign up at https://cloudinary.com — free tier is sufficient to start
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ─── Safaricom Daraja (M-Pesa) ────────────────────────────────────────────────
# Get credentials at https://developer.safaricom.co.ke
MPESA_ENV=sandbox                # or "production"
MPESA_CONSUMER_KEY=your_consumer_key
MPESA_CONSUMER_SECRET=your_consumer_secret
MPESA_BUSINESS_CODE=174379       # Paybill or Till number
MPESA_PASSKEY=your_passkey
MPESA_CALLBACK_URL=https://your-domain.com/api/mpesa/callback

# ─── Stripe (Card Payments) ───────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# ─── Africa's Talking (SMS) ───────────────────────────────────────────────────
# Get credentials at https://africastalking.com
AFRICASTALKING_API_KEY=your_api_key
AFRICASTALKING_USERNAME=sandbox  # or your production username

# ─── Admin ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_ADMIN_PASSWORD=foine2026
